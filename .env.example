# === LLM compatible OpenAI ===
# OpenAI API:
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=<modele-openai>
#
# Hugging Face Inference Providers:
# LLM_BASE_URL=https://router.huggingface.co/v1
# HF_TOKEN=hf_...
# LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
#
# LM Studio local:
# - hors Docker: http://localhost:1234/v1
# - depuis Docker: http://host.docker.internal:1234/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3-4b-2507
LLM_TIMEOUT=180
LLM_MAX_COMPLETION_TOKENS=1200

# === Embeddings (sentence-transformers, CPU) ===
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# === Chroma (vector store) ===
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rncp_referentiel

# === Paramètres RAG ===
RETRIEVER_K=12
